[Unit]
Description=El Grande BlueSeer ERP API (local only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/el-grande/blueseer
ExecStart=/usr/bin/java -cp /opt/el-grande/java/classes:/opt/el-grande/java/lib/* utilities.apiServer -config bs.cfg -port 8088
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/el-grande

[Install]
WantedBy=default.target
